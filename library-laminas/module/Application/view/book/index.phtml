<body>

<div class="books-page">

    <div class="books-header">

        <h1 class="books-title">
            Books
        </h1>

        <div class="books-buttons">

            <?php if ($isAdmin): ?>

                <a
                    href="<?= $this->url('books-add') ?>"
                    class="page-button add-button"
                >
                    + Add Book
                </a>

            <?php endif; ?>

            <a
                href="<?= $this->url('books-stock') ?>"
                class="page-button stock-button"
            >
                Stock
            </a>

            <a
                href="<?= $this->url('home') ?>"
                class="page-button home-button"
            >
                Back to Home
            </a>

        </div>

    </div>

    <div id="booksGrid"></div>

</div>


<script>

$(document).ready(function () {

    var books = [

        <?php

        $displayId = 1;

        foreach ($books as $book):

        ?>

        {
            id: <?= $displayId ?>,

            title: <?= json_encode(
                (string)($book['Title'] ?? '')
            ) ?>,

            author: <?= json_encode(
                (string)($book['Author'] ?? '')
            ) ?>,

            category: <?= json_encode(
                (string)($book['Category'] ?? '')
            ) ?>,

            stock: <?= (int)($book['Stock'] ?? 0) ?>,

            databaseId: <?= (int)($book['id'] ?? 0) ?>
        },

        <?php

        $displayId++;

        endforeach;

        ?>

    ];


    var source = {

        datatype: "array",

        localdata: books,

        datafields: [

            {
                name: "id",
                type: "number"
            },

            {
                name: "title",
                type: "string"
            },

            {
                name: "author",
                type: "string"
            },

            {
                name: "category",
                type: "string"
            },

            {
                name: "stock",
                type: "number"
            },

            {
                name: "databaseId",
                type: "number"
            }

        ]

    };


    var dataAdapter =
        new $.jqx.dataAdapter(source);


    $("#booksGrid").jqxGrid({

        source: dataAdapter,

        width: "100%",

        autoheight: true,

        autorowheight: true,

        columnsheight: 40,

        rowsheight: 38,

        pageable: true,

        pagesize: 7,

        pagesizeoptions: [
            "5",
            "7",
            "10",
            "20"
        ],

        sortable: true,

        filterable: true,

        showfilterrow: true,

        autoshowfiltericon: false,

        columnsresize: true,

        selectionmode: "singlerow",

        columns: [

            {
                text: "ID",

                datafield: "id",

                width: "8%",

                cellsalign: "center",

                align: "center",

                filtertype: "number"
            },

            {
                text: "Title",

                datafield: "title",

                width: "25%",

                filtertype: "input"
            },

            {
                text: "Author",

                datafield: "author",

                width: "22%",

                filtertype: "input"
            },

            {
                text: "Category",

                datafield: "category",

                width: "18%",

                filtertype: "input"
            },

            {
                text: "Stock",

                datafield: "stock",

                width: "10%",

                cellsalign: "center",

                align: "center",

                filterable: false,

                cellsrenderer: function (
                    row,
                    columnfield,
                    value
                ) {

                    if (parseInt(value) > 0) {

                        return `
                            <div
                                style="
                                    margin-top:10px;
                                    text-align:center;
                                "
                                class="stock-available"
                            >
                                ${value}
                            </div>
                        `;

                    }

                    return `
                        <div
                            style="
                                margin-top:10px;
                                text-align:center;
                            "
                            class="stock-unavailable"
                        >
                            Out of Stock
                        </div>
                    `;

                }

            },

            {
                text: "Actions",

                datafield: "databaseId",

                width: "17%",

                sortable: false,

                filterable: false,

                cellsalign: "center",

                align: "center",

                cellsrenderer: function (
                    row,
                    columnfield,
                    value,
                    defaulthtml,
                    columnproperties,
                    rowdata
                ) {

                    var databaseId =
                        rowdata.databaseId;


                    <?php if ($isAdmin): ?>

                    var editUrl =
                        <?= json_encode(
                            $this->url('books-edit')
                        ) ?>
                        + "/"
                        + databaseId;


                    var deleteUrl =
                        <?= json_encode(
                            $this->url('books-delete')
                        ) ?>
                        + "/"
                        + databaseId;


                    return `

                        <div style="text-align:center;">

                            <a
                                href="${editUrl}"
                                class="grid-action-button edit-button"
                            >
                                Edit
                            </a>

                            <a
                                href="${deleteUrl}"
                                class="grid-action-button delete-button"
                                onclick="return confirm('Are you sure you want to delete this book?');"
                            >
                                Delete
                            </a>

                        </div>

                    `;

                    <?php else: ?>

                    var buyUrl =
                        <?= json_encode(
                            $this->url('books-buy')
                        ) ?>
                        + "/"
                        + databaseId;


                    if (parseInt(rowdata.stock) <= 0) {

                        return `

                            <div style="text-align:center;">

                                <span
                                    class="stock-unavailable"
                                >
                                    Unavailable
                                </span>

                            </div>

                        `;

                    }


                    return `

                        <div style="text-align:center;">

                            <a
                                href="${buyUrl}"
                                class="grid-action-button buy-button"
                            >
                                Buy
                            </a>

                        </div>

                    `;

                    <?php endif; ?>

                }

            }

        ]

    });

});

</script>

</body>
</html>