        <p>View and manage the current book stock.</p>
    </div>

    <div class="grid-container">

        <div id="bookStockGrid"></div>

    </div>

</div>


<script>

$(document).ready(function () {

    /*
     * ---------------------------------------------------------
     * BOOK DATA FROM PHP
     * ---------------------------------------------------------
     */

    var books = [

        <?php
        $displayId = 1;

        foreach ($books as $book):

            $stock = (int)($book['Stock'] ?? 0);

            $status = $stock > 0
                ? 'Available'
                : 'Unavailable';

        ?>

        {
            id: <?= $displayId ?>,

            title: <?= json_encode(
                (string)($book['Title'] ?? ''),
                JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
            ) ?>,

            author: <?= json_encode(
                (string)($book['Author'] ?? ''),
                JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
            ) ?>,

            category: <?= json_encode(
                (string)($book['Category'] ?? ''),
                JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
            ) ?>,

            stock: <?= $stock ?>,

            status: <?= json_encode($status) ?>,

            databaseId: <?= (int)($book['id'] ?? 0) ?>,

            action: ""
        },

        <?php

            $displayId++;

        endforeach;
        ?>

    ];


    /*
     * ---------------------------------------------------------
     * DATA SOURCE
     * ---------------------------------------------------------
     */

    var source = {
        datatype: "array",

        localdata: books,

        datafields: [

            {
                name: "id",
                type: "number"
            },

            {
                name: "title",
                type: "string"
            },

            {
                name: "author",
                type: "string"
            },

            {
                name: "category",
                type: "string"
            },

            {
                name: "stock",
                type: "number"
            },

            {
                name: "status",
                type: "string"
            },

            {
                name: "databaseId",
                type: "number"
            },

            {
                name: "action",
                type: "string"
            }

        ]
    };


    /*
     * ---------------------------------------------------------
     * CREATE ADAPTER
     * ---------------------------------------------------------
     */

    var dataAdapter = new $.jqx.dataAdapter(source);


    /*
     * ---------------------------------------------------------
     * CREATE GRID
     * ---------------------------------------------------------
     */

    $("#bookStockGrid").jqxGrid({

        width: "100%",

        source: dataAdapter,

        theme: "material",

        pageable: true,

        pagesize: 10,

        autoheight: true,

        sortable: true,

        filterable: true,

        columnsresize: true,

        selectionmode: "singlerow",

        columns: [

            /*
             * ID
             */
            {
                text: "ID",

                datafield: "id",

                width: 70,

                cellsalign: "center",

                align: "center"
            },


            /*
             * TITLE
             */
            {
                text: "Title",

                datafield: "title",

                minwidth: 200,

                align: "center"
            },


            /*
             * AUTHOR
             */
            {
                text: "Author",

                datafield: "author",

                minwidth: 180,

                align: "center"
            },


            /*
             * CATEGORY
             */
            {
                text: "Category",

                datafield: "category",

                minwidth: 150,

                align: "center"
            },


            /*
             * STOCK
             */
            {
                text: "Stock",

                datafield: "stock",

                width: 100,

                cellsalign: "center",

                align: "center",

                cellsrenderer: function (
                    row,
                    column,
                    value
                ) {

                    var stockValue = parseInt(value, 10);

                    if (stockValue > 0) {

                        return '<div style="padding: 8px; text-align: center;" class="stock-available">'
                            + stockValue +
                            '</div>';

                    }

                    return '<div style="padding: 8px; text-align: center;" class="stock-unavailable">'
                        + stockValue +
                        '</div>';
                }
            },


            /*
             * STATUS
             *
             * IMPORTANT:
             * This uses "status", NOT "stock".
             * This fixes the duplicate datafield error.
             */
            {
                text: "Status",

                datafield: "status",

                width: 130,

                cellsalign: "center",

                align: "center",

                cellsrenderer: function (
                    row,
                    column,
                    value
                ) {

                    if (value === "Available") {

                        return '<div style="padding: 8px; text-align: center;" class="status-available">'
                            + 'Available' +
                            '</div>';

                    }

                    return '<div style="padding: 8px; text-align: center;" class="status-unavailable">'
                        + 'Unavailable' +
                        '</div>';
                }
            },


            /*
             * ACTION
             */
            {
                text: "Action",

                datafield: "action",

                width: 130,

                cellsalign: "center",

                align: "center",

                sortable: false,

                filterable: false,

                cellsrenderer: function (
                    row,
                    column,
                    value,
                    defaultHtml,
                    columnProperties,
                    rowData
                ) {

                    var databaseId = rowData.databaseId;

                    var stockValue = parseInt(
                        rowData.stock,
                        10
                    );


                    /*
                     * No database ID
                     */
                    if (!databaseId) {

                        return '<div style="padding: 5px; text-align: center;">'
                            + '<span class="disabled-button">Unavailable</span>'
                            + '</div>';
                    }


                    /*
                     * No stock
                     */
                    if (stockValue <= 0) {

                        return '<div style="padding: 5px; text-align: center;">'
                            + '<span class="disabled-button">Out of Stock</span>'
                            + '</div>';
                    }


                    /*
                     * BUY URL
                     */
                    var buyUrl = <?= json_encode(
                        $this->url('books-buy')
                    ) ?>;


                    /*
                     * Add ID to URL
                     */
                    buyUrl = buyUrl.replace(
                        /\/$/,
                        ''
                    );

                    buyUrl += '/'
                        + encodeURIComponent(databaseId);


                    return '<div style="padding: 5px; text-align: center;">'
                        + '<a href="'
                        + buyUrl
                        + '" class="buy-button">'
                        + 'Buy'
                        + '</a>'
                        + '</div>';
                }
            }

        ]

    });

});

</script>

</body>
</html>